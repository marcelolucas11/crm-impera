# Modelo de configuração. O ./instalar.sh gera o .env real com senhas aleatórias.
# O .env NUNCA vai para o GitHub.

APP_PORT=3000
# 127.0.0.1 = só esta máquina acessa. Use 0.0.0.0 para liberar para a rede local.
HOST=127.0.0.1
# Endereço público (Tailscale Funnel no Mac, domínio na VPS). Usado para mostrar a URL do webhook.
PUBLIC_URL=
# Opcional: caminho do CRM no domínio (ex.: /interno). Se vazio, usa o caminho do PUBLIC_URL.
# O CRM continua atendendo também na raiz.
BASE_PATH=

SESSION_SECRET=troque-isto-por-um-texto-longo-e-aleatorio

# Pastas (relativas a esta pasta)
DB_FILE=../dados/crm.db
FILES_DIR=../arquivos
BACKUP_DIR=../backups

# DDI colocado na frente de telefones com DDD + número (10 ou 11 dígitos)
DDI_PADRAO=55
# Depois de quantas horas sem contato o lead fica marcado como atrasado
FOLLOWUP_HORAS=24

# Calendly — grave o token com ./scripts/configurar-calendly.sh (nunca no GitHub)
CALENDLY_TOKEN=
# De quantos em quantos minutos o CRM busca reuniões novas
CALENDLY_INTERVALO_MIN=5

# WhatsApp por QR code (0 desliga)
WHATSAPP_ATIVO=1
# 1 = conversa nova de número desconhecido vira lead sozinha; 0 = aparece na tela de WhatsApp com o botão "Transformar em lead"
WHATSAPP_CRIAR_LEADS=0
# Dias de conversas antigas importadas ao conectar um número (0 = não importa). Padrão: 90 (3 meses)
WHATSAPP_HISTORICO_DIAS=90
# 1 = conversas de grupo aparecem na tela de WhatsApp (grupos nunca viram lead); 0 = ignora grupos
WHATSAPP_GRUPOS=1
# 1 = ao enviar um link, manda a prévia (título e imagem) como o WhatsApp Web; 0 = sem prévia
WHATSAPP_PREVIA_LINKS=1
# Mídias recebidas até este tamanho (MB) são baixadas na hora; maiores, quando alguém abrir
WHATSAPP_MIDIA_AUTO_MB=25
# Tamanho máximo (MB) de arquivo enviado pelo CRM
WHATSAPP_ENVIO_MAX_MB=100
# 1 = abrir a conversa no CRM marca como lida no WhatsApp (✓✓ azul para o contato)
WHATSAPP_CONFIRMAR_LEITURA=1

# Yay! Forms
# Token que vai no final da URL do webhook (protege o endpoint)
YAYFORMS_WEBHOOK_TOKEN=troque-isto
# Opcional: o mesmo "Secret" configurado no webhook do Yay! Forms (assinatura HMAC SHA256)
YAYFORMS_WEBHOOK_SECRET=
# Opcional: IDs exatos das perguntas, caso a detecção automática de nome/telefone/e-mail erre
YAYFORMS_CAMPO_NOME=
YAYFORMS_CAMPO_TELEFONE=
YAYFORMS_CAMPO_EMAIL=

# Disparos
# Fuso do {{saudacao}} (bom dia/tarde/noite) e da janela de horário dos disparos
DISPAROS_FUSO=America/Sao_Paulo
