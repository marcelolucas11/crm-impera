# Modelo de configuração. O ./instalar.sh gera o .env real com senhas aleatórias.
# O .env NUNCA vai para o GitHub.

# --- Banco de dados ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=troque-isto
POSTGRES_DB=crm

# --- Pastas no SSD (relativas a esta pasta) ---
HOST_DATA_DIR=../dados
HOST_FILES_DIR=../arquivos
BACKUP_DIR=../backups

# --- App ---
APP_PORT=3000
SESSION_SECRET=troque-isto-por-um-texto-longo-e-aleatorio
# Endereço público (Tailscale Funnel no Mac, domínio na VPS). Usado para mostrar a URL do webhook.
PUBLIC_URL=

# DDI colocado na frente de telefones com DDD + número (10 ou 11 dígitos)
DDI_PADRAO=55

# --- Follow-up ---
# Depois de quantas horas sem contato o lead fica marcado como atrasado
FOLLOWUP_HORAS=24

# --- Yay! Forms ---
# Token que vai no final da URL do webhook (protege o endpoint)
YAYFORMS_WEBHOOK_TOKEN=troque-isto
# Opcional: o mesmo "Secret" configurado no webhook do Yay! Forms (assinatura HMAC SHA256)
YAYFORMS_WEBHOOK_SECRET=
# Opcional: IDs exatos das perguntas, caso a detecção automática de nome/telefone/e-mail erre
YAYFORMS_CAMPO_NOME=
YAYFORMS_CAMPO_TELEFONE=
YAYFORMS_CAMPO_EMAIL=
